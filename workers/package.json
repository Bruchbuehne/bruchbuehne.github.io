{
  "name": "bruchbuehne-workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers for Bruchbühne reservations",
  "type": "module",
  "scripts": {
    "deploy": "npm run sync-shows:remote && wrangler deploy",
