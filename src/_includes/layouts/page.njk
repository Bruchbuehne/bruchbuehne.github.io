---
layout: layouts/base.njk
---

<div class="container page-wrapper">
  <article class="page">
    <header class="page-header">
      <h1 class="page-header__title">{{ title }}</h1>
      {% if subtitle %}
        <p class="page-header__subtitle">{{ subtitle }}</p>
      {% endif %}
    </header>

    <div class="page-content">
      {{ content | safe }}
    </div>
  </article>
</div>
