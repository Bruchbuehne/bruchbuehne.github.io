---
layout: layouts/base.njk
title: Home
---

<div class="container">
  <header class="homepage-header">
    <h1 class="homepage-header__title">{{ site.name }}</h1>
    <p class="homepage-header__subtitle">eine lustige tag-line</p>
    {% if site.reservations and site.currentProduction %}
      <div class="mt-md">
        <a href="/reservierungen/" class="btn btn--secondary">Karten für {{ site.currentProduction.title }} reservieren</a>
      </div>
    {% endif %}
  </header>

  <div class="masonry-grid">
    {% for production in collections.inszenierungen %}
      {% set isLatest = loop.first %}
      {% include "partials/production-card.njk" %}
    {% endfor %}
  </div>
</div>
